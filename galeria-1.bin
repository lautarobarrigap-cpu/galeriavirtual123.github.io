  else if(name==='noche'){ amb('#141a26',0.32); hemi('#2c3856','#0b0f16',0.28); dir('#9fb4e0',0.16,[-3,12,-4]); }
  else { amb('#ffffff',0.5); hemi('#ffffff','#9a8f7d',0.5); dir('#fff7e8',0.3,[6,12,4]); }
