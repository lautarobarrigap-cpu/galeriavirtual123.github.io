function resolveWalls(px,pz){ for(var it=0;it<3;it++){ for(var i=0;i<wallSegs.length;i++){ var s=wallSegs[i]; var dx=s.x2-s.x1,dz=s.z2-s.z1,len2=dx*dx+dz*dz; var t=len2>0?((px-s.x1)*dx+(pz-s.z1)*dz)/len2:0; t=Math.max(0,Math.min(1,t)); var cx=s.x1+t*dx, cz=s.z1+t*dz; var ox=px-cx, oz=pz-cz; var d=Math.hypot(ox,oz); if(d<PLAYER_R){ if(d<1e-4){ox=-dz;oz=dx;d=Math.hypot(ox,oz)||1;} var kf=(PLAYER_R-d)/d; px+=ox*kf; pz+=oz*kf; } } } return [px,pz]; }
function insideGallery(x,z){ for(var i=0;i<cells.length;i++) if(pointInPoly(x,z,cells[i].poly)) return true; return false; }
function overOpening(x,z){ var fe=floorElevation(plan,activeFloor); for(var i=0;i<STAIRS.length;i++){ var st=STAIRS[i]; if(st.floorHi===activeFloor && pointInPoly(x,z,st.foot.poly)){ var su=stairSurface(st,x,z); var inLane=su.dist<=st.width*0.5+0.32; var nearTop=stairYAt(st,su.t)>fe-1.1; if(inLane||nearTop) continue; return true; } } for(var a2=0;a2<ATRIA.length;a2++){ if(ATRIA[a2].floorHi===activeFloor && pointInPoly(x,z,ATRIA[a2].poly)) return true; } return false; }
function buildAtriumEdge(poly,E,feet){ var g=new THREE.Group(); var kerbMat=new THREE.MeshStandardMaterial({color:'#b9b2a4',roughness:0.85}); var railMat=new THREE.MeshStandardMaterial({color:'#8a6f3f',metalness:0.55,roughness:0.35}); var onStairGap=function(x,z){ if(!feet||!feet.length)return false; for(var q=0;q<feet.length;q++){ var f=feet[q]; if(f.poly?pointInPoly(x,z,f.poly):(x>=f.x&&x<=f.x+f.w&&z>=f.z&&z<=f.z+f.h)) return true; } return false; }; var geoms=[]; for(var i=0;i<poly.length;i++){ var a=poly[i], b=poly[(i+1)%poly.length]; var len=Math.hypot(b[0]-a[0],b[1]-a[1]); if(len<0.04) continue; var n0=Math.max(1,Math.round(len/0.5)); for(var s=0;s<n0;s++){ var t0=s/n0, t1=(s+1)/n0; var mx=a[0]+(b[0]-a[0])*(t0+t1)/2, mz=a[1]+(b[1]-a[1])*(t0+t1)/2; if(onStairGap(mx,mz)) continue; geoms.push(orientedWallGeom(a[0]+(b[0]-a[0])*t0, a[1]+(b[1]-a[1])*t0, a[0]+(b[0]-a[0])*t1, a[1]+(b[1]-a[1])*t1, E-0.10, 0.14)); } } if(geoms.length){ var kerb=new THREE.Mesh(mergeGeometries(geoms,false),kerbMat); kerb.castShadow=true; kerb.receiveShadow=true; g.add(kerb); } var rUp=new THREE.Vector3(0,1,0); var railSeg=function(x1,z1,x2,z2){ var len=Math.hypot(x2-x1,z2-z1); if(len<0.25)return; var n=Math.max(2,Math.round(len/1.1)+1); var prev=null; for(var i2=0;i2<=n;i2++){ var t=i2/n, px=x1+(x2-x1)*t, pz=z1+(z2-z1)*t; var gap=onStairGap(px,pz); if(!gap){ var post=new THREE.Mesh(new THREE.CylinderGeometry(0.028,0.028,1.0,8),railMat); post.position.set(px,E+0.5,pz); post.receiveShadow=true; g.add(post); } var cur={x:px,y:E+1.0,z:pz,gap:gap}; if(prev && !prev.gap && !gap){ var ddx=cur.x-prev.x,ddz=cur.z-prev.z,l2=Math.hypot(ddx,ddz); if(l2>0.05){ var tb=new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.03,l2,8),railMat); tb.position.set((cur.x+prev.x)/2,cur.y,(cur.z+prev.z)/2); tb.quaternion.setFromUnitVectors(rUp,new THREE.Vector3(ddx,0,ddz).normalize()); tb.receiveShadow=true; g.add(tb); } } prev=cur; } }; for(var j=0;j<poly.length;j++){ var aj=poly[j], bj=poly[(j+1)%poly.length]; railSeg(aj[0],aj[1],bj[0],bj[1]); } return g; }
function tryMove(ox,oz,mx,mz){ var r=resolveWalls(ox+mx,oz+mz); return (insideGallery(r[0],r[1]) && !overOpening(r[0],r[1]))?r:null; }
var _ray=new THREE.Raycaster();
function pickAt(nx,ny){ _ray.setFromCamera({x:nx,y:ny},camera); var hits=_ray.intersectObjects(pickMeshes,false); if(!hits.length||hits[0].distance>=28) return null; var wb=_ray.intersectObject(galleryGroup,true); if(wb.length && wb[0].distance < hits[0].distance-0.02) return null; return hits[0].object.userData.art; }
var crosshair=document.getElementById('crosshair');
var tip=document.getElementById('tip'), tipT=document.getElementById('tipT'), tipD=document.getElementById('tipD'), tipX=document.getElementById('tipX');
var benchHint=document.getElementById('benchHint');
var tourMsg=document.getElementById('tourMsg'), tourStartBar=document.getElementById('tourStart'), tourNavBar=document.getElementById('tourNav');
function aimingAtTour(){ if(!tourGroup||!tourGroup.children.length) return false; _ray.setFromCamera({x:0,y:0},camera); var h=_ray.intersectObjects(tourGroup.children,true); return h.length>0 && h[0].distance<30; }
document.getElementById('tsBtn').addEventListener('click',function(e){ e.stopPropagation(); if(!tourPlaying) startTour(); });
document.getElementById('tnPrev').addEventListener('click',function(e){ e.stopPropagation(); if(tourPlaying) tourGoTo(tourDestIdx-1); });
document.getElementById('tnNext').addEventListener('click',function(e){ e.stopPropagation(); if(!tourPlaying) startTour(); else tourGoTo(tourDestIdx+1); });
document.getElementById('tnExit').addEventListener('click',function(e){ e.stopPropagation(); exitTour(); });
var SIT_TXT=isTouch?'Toca para sentarte':'Clic para sentarte', STAND_TXT=isTouch?'Toca para ponerte de pie':'Clic para ponerte de pie';
var viewer=document.getElementById('viewer'), viewerImg=document.getElementById('viewerImg'), vT=document.getElementById('vT'), vD=document.getElementById('vD'), vX=document.getElementById('vX');
var enter=document.getElementById('enter'), hint=document.getElementById('hint'), loadingEl=document.getElementById('loading');
function showTip(art){ tipT.textContent=art.data.title||'Sin título'; tipD.textContent=art.data.date||''; tipX.textContent=art.data.desc||''; tip.classList.add('show'); }
function hideTip(){ tip.classList.remove('show'); }
var viewerOpenedAt=0;
function openViewer(art){ if(art.kind!=='image')return; if(document.pointerLockElement) document.exitPointerLock(); viewerImg.src=art.data.dataURL; vT.textContent=art.data.title||'Sin título'; vD.textContent=art.data.date||''; vX.textContent=art.data.desc||''; viewerOpenedAt=performance.now(); viewer.classList.add('show'); hideTip(); }
function closeViewer(){ viewer.classList.remove('show'); }
viewer.addEventListener('click',function(e){ if(performance.now()-viewerOpenedAt<450)return; if(!e.target.closest('.vmeta')) closeViewer(); });
document.getElementById('viewerClose').addEventListener('click',function(e){ e.stopPropagation(); if(performance.now()-viewerOpenedAt<450)return; closeViewer(); });
var keys={};
addEventListener('keydown',function(e){ var k=e.key.toLowerCase(); keys[k]=true; if(['w','a','s','d',' '].indexOf(k)>=0)e.preventDefault(); if(e.key==='Escape'){ if(viewer.classList.contains('show'))closeViewer(); }
  if(destIdxs().length){ if(e.key==='ArrowRight'){ if(!tourPlaying) startTour(); else tourGoTo(tourDestIdx+1); e.preventDefault(); return; } if(e.key==='ArrowLeft'){ if(tourPlaying) tourGoTo(tourDestIdx-1); e.preventDefault(); return; } if(tourPlaying && (k==='w'||k==='a'||k==='s'||k==='d')){ exitTour(); } } });
addEventListener('keyup',function(e){ keys[e.key.toLowerCase()]=false; });
function startDesktop(){ if(canvas.requestPointerLock) canvas.requestPointerLock(); }
addEventListener('mousemove',function(e){ if(document.pointerLockElement===canvas){ var C=110, mx=e.movementX||0, my=e.movementY||0; if(mx>C)mx=C; else if(mx<-C)mx=-C; if(my>C)my=C; else if(my<-C)my=-C; yaw-=mx*0.0022; pitch-=my*0.0022; if(pitch>1.45)pitch=1.45; if(pitch<-1.45)pitch=-1.45; applyCam(); } });
canvas.addEventListener('click',function(){ if(viewer.classList.contains('show'))return; if(document.pointerLockElement!==canvas){ startDesktop(); } else { if(seated){ standUp(); return; } if(!tourPlaying && tourStartTok && tourStartTok.visible){ _ray.setFromCamera({x:0,y:0},camera); var th=_ray.intersectObject(tourStartTok,false); if(th.length){ startTour(); return; } } var art=pickAt(0,0); if(art){ if(art.kind==='asset'&&art.asset==='bench'){ sitOnBench(art); } else if(art.kind==='image'){ openViewer(art); } } } });
document.addEventListener('pointerlockchange',function(){ var locked=document.pointerLockElement===canvas; if(!isTouch){ crosshair.classList.toggle('show',locked); if(!locked && !viewer.classList.contains('show')) hint.classList.add('show'); else hint.classList.remove('show'); } });
var joy={f:0,r:0,active:false,id:null,cx:0,cy:0};
var joyEl=document.getElementById('joy'), knob=document.getElementById('knob'); var JOY_R=54;
function insideEl(t,el){ var r=el.getBoundingClientRect(); return t.clientX>=r.left-14&&t.clientX<=r.right+14&&t.clientY>=r.top-14&&t.clientY<=r.bottom+14; }
function joyMove(t){ var dx=t.clientX-joy.cx, dy=t.clientY-joy.cy; var d=Math.hypot(dx,dy); var m=Math.min(d,JOY_R); var a=Math.atan2(dy,dx); var kx=Math.cos(a)*m, ky=Math.sin(a)*m; knob.style.transform='translate('+kx+'px,'+ky+'px)'; joy.r=kx/JOY_R; joy.f=-ky/JOY_R; }
var lookId=null, lookX=0, lookY=0, moved=0, tapX=0, tapY=0, downT=0;
addEventListener('touchstart',function(e){ if(viewer.classList.contains('show'))return; for(var i=0;i<e.changedTouches.length;i++){ var t=e.changedTouches[i]; if(!joy.active && insideEl(t,joyEl)){ var r=joyEl.getBoundingClientRect(); joy.active=true; joy.id=t.identifier; joy.cx=r.left+r.width/2; joy.cy=r.top+r.height/2; joyMove(t); } else if((tourStartBar.classList.contains('show')&&insideEl(t,tourStartBar))||(tourNavBar.classList.contains('show')&&insideEl(t,tourNavBar))){ /* toque sobre un botón del recorrido: que lo maneje el propio botón */ } else if(lookId===null){ lookId=t.identifier; lookX=t.clientX; lookY=t.clientY; moved=0; tapX=t.clientX; tapY=t.clientY; downT=performance.now(); } } },{passive:false});
addEventListener('touchmove',function(e){ if(viewer.classList.contains('show'))return; for(var i=0;i<e.changedTouches.length;i++){ var t=e.changedTouches[i]; if(joy.active&&t.identifier===joy.id){ joyMove(t); if(e.cancelable)e.preventDefault(); } else if(t.identifier===lookId){ var dx=t.clientX-lookX, dy=t.clientY-lookY; lookX=t.clientX; lookY=t.clientY; yaw-=dx*0.005; pitch-=dy*0.005; if(pitch>1.45)pitch=1.45; if(pitch<-1.45)pitch=-1.45; applyCam(); moved+=Math.abs(dx)+Math.abs(dy); if(e.cancelable)e.preventDefault(); } } },{passive:false});
addEventListener('touchend',function(e){ if(viewer.classList.contains('show'))return; for(var i=0;i<e.changedTouches.length;i++){ var t=e.changedTouches[i]; if(joy.active&&t.identifier===joy.id){ joy.active=false; joy.id=null; joy.f=0; joy.r=0; knob.style.transform='translate(0,0)'; } else if(t.identifier===lookId){ lookId=null; if(moved<12 && (performance.now()-downT)<320 && enter.classList.contains('hide')){ if(seated){ if(e.cancelable)e.preventDefault(); standUp(); } else { var nx=(tapX/innerWidth)*2-1, ny=-(tapY/innerHeight)*2+1; if(!tourPlaying && tourStartTok && tourStartTok.visible){ _ray.setFromCamera({x:nx,y:ny},camera); var tk=_ray.intersectObject(tourStartTok,false); if(tk.length){ if(e.cancelable)e.preventDefault(); startTour(); return; } } var art=pickAt(nx,ny); if(art){ if(art.kind==='asset'&&art.asset==='bench'){ if(e.cancelable)e.preventDefault(); sitOnBench(art); } else if(art.kind==='image'){ if(e.cancelable)e.preventDefault(); openViewer(art); } } } } } } },{passive:false});
function go(){ enter.classList.add('hide'); hint.classList.add('show'); setTimeout(function(){ hint.classList.remove('show'); },4600); if(!isTouch) startDesktop(); }
enter.addEventListener('click',go);
addEventListener('resize',function(){ camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth,innerHeight); });
if(isTouch){ joyEl.classList.add('show'); document.getElementById('eSub').textContent='Usa el joystick para moverte y arrastra con el dedo para mirar alrededor. Toca un cuadro para verlo en grande.'; document.getElementById('eCta').textContent='Toca para entrar'; hint.textContent='Joystick: moverte · arrastra: mirar · toca un cuadro'; } else { document.getElementById('eSub').textContent='Muévete con W A S D o las flechas y mira con el ratón. Haz clic en un cuadro para ampliarlo. Pulsa Esc para liberar el ratón.'; document.getElementById('eCta').textContent='Haz clic para entrar'; hint.textContent='WASD o flechas: moverte · ratón: mirar · clic: ampliar'; }
var last=performance.now();
function frame(){ requestAnimationFrame(frame); var now=performance.now(); var dt=Math.min(0.05,(now-last)/1000); last=now;
  if(tourPlaying){ if(tourAnim){ var aT=tourAnim; var dur=Math.max(0.6,aT.total/4.5); aT.p=Math.min(1,aT.p+dt/dur); var eT=aT.p<0.5?2*aT.p*aT.p:1-Math.pow(-2*aT.p+2,2)/2; var posT=posAlong(aT.path,aT.p); camPos.set(posT[0],posT[1],posT[2]); var dyaw=aT.toYaw-aT.fromYaw; while(dyaw>Math.PI)dyaw-=2*Math.PI; while(dyaw<-Math.PI)dyaw+=2*Math.PI; yaw=aT.fromYaw+dyaw*eT; pitch=aT.fromPitch+(aT.toPitch-aT.fromPitch)*eT; applyCam(); if(aT.p>=1){ var LT=aT.path[aT.path.length-1]; camPos.set(LT[0],LT[1],LT[2]); yaw=aT.toYaw; pitch=aT.toPitch; applyCam(); tourAnim=null; } } }
  else if(seated){ camPos.set(seated.position.x, seated.position.y+1.02*seated.scale.x, seated.position.z); applyCam(); }
  else {
  var navTour=destIdxs().length>0;
  var inF=(keys.w||keys.arrowup?1:0)-(keys.s||keys.arrowdown?1:0); var inR=(keys.d||(!navTour&&keys.arrowright)?1:0)-(keys.a||(!navTour&&keys.arrowleft)?1:0);
  var f=inF+joy.f, r=inR+joy.r; var L=Math.hypot(f,r); if(L>1){f/=L;r/=L;}
  if(f||r){ var s=SPEED*dt; var dx=(-Math.sin(yaw))*f*s + (Math.cos(yaw))*r*s; var dz=(-Math.cos(yaw))*f*s + (-Math.sin(yaw))*r*s;
    if(onStair){ var lim=onStair.width*0.5+0.05; var nx=camPos.x+dx, nz=camPos.z+dz;
      if(stairSurface(onStair,nx,nz).dist>lim){ if(stairSurface(onStair,camPos.x+dx,camPos.z).dist<=lim){ nz=camPos.z; } else if(stairSurface(onStair,camPos.x,camPos.z+dz).dist<=lim){ nx=camPos.x; } else { nx=camPos.x; nz=camPos.z; } }
      camPos.x=nx; camPos.z=nz; var su=stairSurface(onStair,nx,nz);
      if(su.t<=0.03){ setFloorCollision(onStair.floorLo); onStair=null; } else if(su.t>=0.97){ setFloorCollision(onStair.floorHi); onStair=null; } else { camPos.y=stairYAt(onStair,su.t)+EYE; } }
    else { var mv=tryMove(camPos.x,camPos.z,dx,dz);
      if(mv){ camPos.x=mv[0]; camPos.z=mv[1]; } else { var ax=tryMove(camPos.x,camPos.z,dx,0); if(ax){camPos.x=ax[0];camPos.z=ax[1];} var az=tryMove(camPos.x,camPos.z,0,dz); if(az){camPos.x=az[0];camPos.z=az[1];} }
      var stEnter=stairAt(camPos.x,camPos.z,activeFloor); if(stEnter){ onStair=stEnter; applyFloorLights(); } }
    if(!onStair) camPos.y=floorY+EYE; applyCam(); }
  }
  // --- avisos del recorrido (mensaje abajo-izquierda) y controles táctiles (botones inferiores) ---
  var tmsg='';
  if(seated){ benchHint.textContent=STAND_TXT; benchHint.classList.add('show'); hideTip(); }
  else benchHint.classList.remove('show');
  if(tourPlaying){ var dsP=destIdxs(); tmsg='Recorrido '+(tourDestIdx+1)+' / '+Math.max(1,dsP.length)+(isTouch?'':'   ·   ← →  navegar   ·   WASD  salir'); hideTip(); }
  else if(!seated && (isTouch || document.pointerLockElement===canvas) && !viewer.classList.contains('show')){ var ar=pickAt(0,0);
    if(ar&&ar.kind==='image'){ showTip(ar); }
    else if(ar&&ar.kind==='asset'&&ar.asset==='bench'){ benchHint.textContent=SIT_TXT; benchHint.classList.add('show'); hideTip(); }
    else { hideTip(); if(destIdxs().length && !isTouch) tmsg='Acércate al  1  del suelo o pulsa  →  para iniciar el recorrido'; } }
  else hideTip();
  if(tmsg){ tourMsg.textContent=tmsg; tourMsg.classList.add('show'); } else tourMsg.classList.remove('show');
  if(isTouch){
    var wantStart=false; if(!tourPlaying && destIdxs().length){ var _ns=tourNodes(), _ds=destIdxs(), _d0=_ns[_ds[0]]; var _near=_d0?Math.hypot(camPos.x-_d0.x,camPos.z-_d0.z)<2.6:false; wantStart=_near||aimingAtTour(); }
    tourStartBar.classList.toggle('show', wantStart);
    tourNavBar.classList.toggle('show', tourPlaying);
  }
  // auto-inicio por proximidad: solo en escritorio; en móvil se usa el botón «Iniciar recorrido»
  if(!isTouch && !tourPlaying && destIdxs().length){ var ns2=tourNodes(), ds2=destIdxs(); var d0=ns2[ds2[0]]; if(d0){ var dd=Math.hypot(camPos.x-d0.x, camPos.z-d0.z); if(dd>2.6) tourAutoArmed=true; else if(dd<1.5 && tourAutoArmed && (d0.fl==null||d0.fl===activeFloor)){ tourAutoArmed=false; startTour(); } } }
  if(tourArrows.length) animateTour(now*0.001);
  renderer.render(scene,camera);
}
loadingEl.classList.add('hide');
frame();
</script>
</body>
</html>