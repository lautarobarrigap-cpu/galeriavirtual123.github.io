<script type="importmap">{ "imports": { "three": "https://unpkg.com/three@0.160.0/build/three.module.js", "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/" } }</script>
<script type="module">
import * as THREE from 'three';
import { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';
var H=4.0, WALL_T=0.18, EYE=1.62, PLAYER_R=0.42, SPEED=4.4, BASE_H=1.55;
var ST=JSON.parse(document.getElementById('state').textContent);
var plan=ST.plan;
function defCorrCol(){ return {wall:'#ddd8cf',floor:'#7d7468',ceil:'#ece8df'}; }
function aliasFloor(p){ var f=p.floors[p.activeFloor]||p.floors[0]; p.rooms=f.rooms; p.corridors=f.corridors; p.corridorColors=f.corridorColors; p.corridorTex=f.corridorTex; p.lights=f.lights; p.tour=f.tour; }
function migratePlan(p){ if(!p) return p;
  if(!(p.floors instanceof Array)){ p.floors=[{ name:'Planta 1', rooms:p.rooms||[], corridors:p.corridors||[], corridorColors:p.corridorColors||defCorrCol(), corridorTex:p.corridorTex||{}, lights:p.lights||[], tour:p.tour||[] }]; }
  for(var i=0;i<p.floors.length;i++){ var f=p.floors[i]; if(!f.rooms)f.rooms=[]; if(!f.corridors)f.corridors=[]; if(!f.corridorColors)f.corridorColors=defCorrCol(); if(!f.corridorTex)f.corridorTex={}; if(!f.lights)f.lights=[]; if(!f.tour)f.tour=[]; if(!f.name)f.name='Planta'; }
  if(!(p.stairs instanceof Array)) p.stairs=[];
  for(var si9=0;si9<p.stairs.length;si9++){ if(p.stairs[si9].type==='spiralL'||p.stairs[si9].type==='spiralR') p.stairs[si9].type='straight'; }
  if(!(p.tourNodes instanceof Array)) p.tourNodes=[];
  if(p.activeFloor==null||p.activeFloor<0||p.activeFloor>=p.floors.length) p.activeFloor=0;
  if(p.floorHeight==null) p.floorHeight=(p.wallHeight||H)+0.7;
  if(p.shadows===undefined) p.shadows=true;
  aliasFloor(p); return p; }
function floorElevation(p,i){ return i*(p.floorHeight||((p.wallHeight||H)+0.7)); }
function footCorners(f){ return f.poly || [[f.x,f.z],[f.x+f.w,f.z],[f.x+f.w,f.z+f.h],[f.x,f.z+f.h]]; }
function orientedSlab(cx,cy,cz,sx,sz,ang,mat,thick){ var g=new THREE.BoxGeometry(sx,thick||0.08,sz); var m=new THREE.Matrix4().makeRotationY(ang||0); m.setPosition(cx,cy,cz); g.applyMatrix4(m); return new THREE.Mesh(g,mat); }
function orientedWallGeom(x1,z1,x2,z2,yBase,hgt){ var dx=x2-x1,dz=z2-z1,L=Math.hypot(dx,dz); var g=new THREE.BoxGeometry(L,hgt,WALL_T); var m=new THREE.Matrix4().makeRotationY(Math.atan2(-dz,dx)); m.setPosition((x1+x2)/2,yBase+hgt/2,(z1+z2)/2); g.applyMatrix4(m); return g; }
function flatSlab(cx,cy,cz,wx,wz,mat,thick){ var g=new THREE.BoxGeometry(wx,thick||0.08,wz); g.translate(cx,cy,cz); return new THREE.Mesh(g,mat); }
function clipRectToPoly(poly,rx,rz,rw,rh){ var edges=[[0,rx],[1,rx+rw],[2,rz],[3,rz+rh]]; var inside=function(p,e){ return e[0]===0?p[0]>=e[1]: e[0]===1?p[0]<=e[1]: e[0]===2?p[1]>=e[1]: p[1]<=e[1]; }; var inter=function(a,b,e){ var t=(e[0]<2)?(e[1]-a[0])/((b[0]-a[0])||1e-12):(e[1]-a[1])/((b[1]-a[1])||1e-12); return [a[0]+(b[0]-a[0])*t, a[1]+(b[1]-a[1])*t]; }; var out=[]; for(var k=0;k<poly.length;k++) out.push([poly[k][0],poly[k][1]]); for(var ei=0;ei<edges.length;ei++){ var e=edges[ei], inp=out; out=[]; if(!inp.length) break; for(var i=0;i<inp.length;i++){ var A=inp[i], B=inp[(i+1)%inp.length], ia=inside(A,e), ib=inside(B,e); if(ia){ out.push(A); if(!ib) out.push(inter(A,B,e)); } else if(ib){ out.push(inter(A,B,e)); } } } return out; }
function polyAreaAbs(poly){ var a=0; for(var i=0;i<poly.length;i++){ var p=poly[i], q=poly[(i+1)%poly.length]; a+=p[0]*q[1]-q[0]*p[1]; } return Math.abs(a)/2; }
function _clipHalf(poly, A, B, keepSign){ var ex=B[0]-A[0], ez=B[1]-A[1]; var side=function(p){ return ((p[0]-A[0])*ez-(p[1]-A[1])*ex)*keepSign; }; var out=[]; if(!poly.length) return out; for(var k=0;k<poly.length;k++){ var P=poly[k], Q=poly[(k+1)%poly.length]; var sp=side(P), sq=side(Q); if(sp>=-1e-9){ out.push(P); if(sq<-1e-9){ var t=sp/(sp-sq); out.push([P[0]+(Q[0]-P[0])*t, P[1]+(Q[1]-P[1])*t]); } } else if(sq>=-1e-9){ var t2=sp/(sp-sq); out.push([P[0]+(Q[0]-P[0])*t2, P[1]+(Q[1]-P[1])*t2]); } } return out; }
function isConvexPoly(poly){ if(poly.length<4) return true; var sign=0, n=poly.length; for(var i=0;i<n;i++){ var a=poly[i],b=poly[(i+1)%n],c=poly[(i+2)%n]; var cr=(b[0]-a[0])*(c[1]-b[1])-(b[1]-a[1])*(c[0]-b[0]); if(Math.abs(cr)<1e-9) continue; var s=Math.sign(cr); if(sign===0)sign=s; else if(s!==sign) return false; } return true; }
function polyDiffConvex(subj, clip){ if(!subj || subj.length<3) return []; var cx=0,cz=0; for(var i0=0;i0<clip.length;i0++){cx+=clip[i0][0];cz+=clip[i0][1];} cx/=clip.length; cz/=clip.length; var pieces=[]; var remaining=[]; for(var s0=0;s0<subj.length;s0++)remaining.push([subj[s0][0],subj[s0][1]]);
  for(var i=0;i<clip.length && remaining.length>=3;i++){ var A=clip[i], B=clip[(i+1)%clip.length]; var ex=B[0]-A[0], ez=B[1]-A[1]; var inSign=Math.sign((cx-A[0])*ez-(cz-A[1])*ex)||1;
    var outside=_clipHalf(remaining, A, B, -inSign); if(outside.length>=3 && polyAreaAbs(outside)>0.02) pieces.push(outside);
    remaining=_clipHalf(remaining, A, B, inSign); }
  return pieces; }
function clipPolyConvex(subject, clip){ var cx=0,cz=0; for(var i0=0;i0<clip.length;i0++){cx+=clip[i0][0];cz+=clip[i0][1];} cx/=clip.length; cz/=clip.length; var out=[]; for(var s0=0;s0<subject.length;s0++)out.push([subject[s0][0],subject[s0][1]]); for(var i=0;i<clip.length;i++){ var A=clip[i], B=clip[(i+1)%clip.length]; var ex=B[0]-A[0], ez=B[1]-A[1]; var sideOf=function(px,pz){ return (px-A[0])*ez-(pz-A[1])*ex; }; var inSign=Math.sign(sideOf(cx,cz))||1; var inside=function(p){ return Math.sign(sideOf(p[0],p[1]))*inSign>=0 || Math.abs(sideOf(p[0],p[1]))<1e-9; }; var inter=function(P,Q){ var sp=sideOf(P[0],P[1]), sq=sideOf(Q[0],Q[1]); var t=sp/((sp-sq)||1e-12); return [P[0]+(Q[0]-P[0])*t, P[1]+(Q[1]-P[1])*t]; }; var inp=out; out=[]; if(!inp.length) break; for(var k=0;k<inp.length;k++){ var P=inp[k], Q=inp[(k+1)%inp.length]; var pin=inside(P), qin=inside(Q); if(pin){ out.push(P); if(!qin) out.push(inter(P,Q)); } else if(qin){ out.push(inter(P,Q)); } } } return out; }
function resampleXZ(wps,N){ var seg=[]; var total=0; for(var i=0;i<wps.length-1;i++){ var d=Math.hypot(wps[i+1].x-wps[i].x,wps[i+1].z-wps[i].z); seg.push(d); total+=d; } if(total<1e-6){ return wps.slice(); } var out=[]; for(var i2=0;i2<=N;i2++){ var dist=total*i2/N, si=0; while(si<seg.length-1 && dist>seg[si]){ dist-=seg[si]; si++; } var a=wps[si], b=wps[si+1]||wps[si]; var u=seg[si]>0?dist/seg[si]:0; out.push({x:a.x+(b.x-a.x)*u, z:a.z+(b.z-a.z)*u, y:a.y+(b.y-a.y)*u}); } return out; }
function stairData(s,p){
  var eLo=floorElevation(p,s.floor), eHi=floorElevation(p,s.floor+1), dy=eHi-eLo;
  var w=Math.max(0.9,s.w||1.4), dir=s.dir||0, run=Math.max(2,s.run||4);
  var ux=Math.sin(dir),uz=Math.cos(dir), rx=Math.cos(dir),rz=-Math.sin(dir);
  var pts, landing=null;
  if(s.type==='u'){ var flightLen=run, off=w*1.05*(s.flip?-1:1), hMid=eLo+dy*0.5;
    var P0={x:s.x,z:s.z,y:eLo}, P1={x:s.x+ux*flightLen,z:s.z+uz*flightLen,y:hMid}, P2={x:P1.x+rx*off,z:P1.z+rz*off,y:hMid}, P3={x:P2.x-ux*flightLen,z:P2.z-uz*flightLen,y:eHi};
    var f1=resampleXZ([P0,P1],22), land=resampleXZ([P1,P2],6), f2=resampleXZ([P2,P3],22);
    pts=f1.concat(land.slice(1)).concat(f2.slice(1));
    landing={cx:(P1.x+P2.x)/2, cz:(P1.z+P2.z)/2, lat:off+w, fwd:w+0.12, y:hMid, angle:dir}; }
  else { pts=resampleXZ([ {x:s.x,z:s.z,y:eLo}, {x:s.x+ux*run,z:s.z+uz*run,y:eHi} ],48); }
  var minx=1e9,maxx=-1e9,minz=1e9,maxz=-1e9; for(var q=0;q<pts.length;q++){ var pp=pts[q]; if(pp.x<minx)minx=pp.x; if(pp.x>maxx)maxx=pp.x; if(pp.z<minz)minz=pp.z; if(pp.z>maxz)maxz=pp.z; }
  var padA=0.34, padC=w*0.5+0.18; var aMin=1e9,aMax=-1e9,cMin=1e9,cMax=-1e9;
  var _topP=pts[pts.length-1], _preP=pts[pts.length-2]||pts[0]; var _ttx=_topP.x-_preP.x, _ttz=_topP.z-_preP.z, _ttl=Math.hypot(_ttx,_ttz)||1, _landD=w*0.65+0.55;
  var footPts=pts.concat([{x:_topP.x+(_ttx/_ttl)*_landD, z:_topP.z+(_ttz/_ttl)*_landD}]);
  for(var qi=0;qi<footPts.length;qi++){ var qq=footPts[qi]; var dxq=qq.x-s.x, dzq=qq.z-s.z; var av=dxq*ux+dzq*uz, cv=dxq*rx+dzq*rz; aMin=Math.min(aMin,av);aMax=Math.max(aMax,av);cMin=Math.min(cMin,cv);cMax=Math.max(cMax,cv); }
  aMin-=padA; aMax+=padA; cMin-=padC; cMax+=padC;
  var flen=aMax-aMin, fwid=cMax-cMin, aC=(aMin+aMax)/2, cC=(cMin+cMax)/2;
  var fcx=s.x+ux*aC+rx*cC, fcz=s.z+uz*aC+rz*cC;
  var _cn=function(as,cs){ return [ fcx+ux*(as*flen/2)+rx*(cs*fwid/2), fcz+uz*(as*flen/2)+rz*(cs*fwid/2) ]; };
  var fpoly=[ _cn(-1,-1), _cn(1,-1), _cn(1,1), _cn(-1,1) ];
  var bx0=1e9,bx1=-1e9,bz0=1e9,bz1=-1e9; for(var bi=0;bi<fpoly.length;bi++){ var pp=fpoly[bi]; bx0=Math.min(bx0,pp[0]);bx1=Math.max(bx1,pp[0]);bz0=Math.min(bz0,pp[1]);bz1=Math.max(bz1,pp[1]); }
  var foot={ poly:fpoly, cx:fcx, cz:fcz, ang:dir, len:flen, wid:fwid, x:bx0, z:bz0, w:bx1-bx0, h:bz1-bz0 };
  return {stair:s, pts:pts, width:w, eLo:eLo, eHi:eHi, floorLo:s.floor, floorHi:s.floor+1, foot:foot, landing:landing}; }
function buildStairNode(sd){ var g=new THREE.Group(); var pts=sd.pts, w=sd.width;
  var treadMat=new THREE.MeshStandardMaterial({color:'#9a8f7d',roughness:0.85,metalness:0.04});
  var riseMat=new THREE.MeshStandardMaterial({color:'#6b6256',roughness:0.9});
  var railMat=new THREE.MeshStandardMaterial({color:'#c8a24a',roughness:0.35,metalness:0.7});
  var nSteps=Math.max(6,Math.round((sd.eHi-sd.eLo)/0.19));
