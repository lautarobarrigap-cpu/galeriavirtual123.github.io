  var fHoles=[], cHoles=[], sFeet=[]; for(var s1=0;s1<stairDatas.length;s1++){ if(stairDatas[s1].floorHi===bfi)fHoles.push(stairDatas[s1].foot); if(stairDatas[s1].floorLo===bfi)cHoles.push(stairDatas[s1].foot); if(stairDatas[s1].floorLo===bfi||stairDatas[s1].floorHi===bfi)sFeet.push(stairDatas[s1].foot); }
