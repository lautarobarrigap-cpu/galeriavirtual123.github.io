<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>Galería virtual</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden;background:#0a0b0d;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;color:#ece8df}
body{touch-action:none;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
canvas#gl{position:fixed;inset:0;width:100%;height:100%;display:block}
#crosshair{position:fixed;left:50%;top:50%;width:22px;height:22px;margin:-11px 0 0 -11px;pointer-events:none;opacity:0;transition:opacity .2s;z-index:5}
#crosshair.show{opacity:.9}
#benchHint{position:fixed;left:50%;top:calc(50% + 26px);transform:translateX(-50%);background:rgba(12,13,16,.82);color:#f4f1ea;font:600 13px -apple-system,Segoe UI,Roboto,sans-serif;padding:7px 13px;border-radius:9px;border:1px solid rgba(214,196,150,.4);pointer-events:none;opacity:0;transition:opacity .15s;z-index:6;white-space:nowrap;box-shadow:0 8px 24px -10px rgba(0,0,0,.7)}
#benchHint.show{opacity:1}
#tourMsg{position:fixed;left:16px;bottom:calc(16px + env(safe-area-inset-bottom));max-width:min(72vw,430px);background:rgba(12,13,16,.82);color:#f4f1ea;font:600 13px -apple-system,Segoe UI,Roboto,sans-serif;padding:8px 13px;border-radius:9px;border:1px solid rgba(214,196,150,.4);pointer-events:none;opacity:0;transition:opacity .15s;z-index:7;box-shadow:0 8px 24px -10px rgba(0,0,0,.7)}
#tourMsg.show{opacity:1}
.tourbar{position:fixed;left:0;right:0;bottom:calc(18px + env(safe-area-inset-bottom));display:none;justify-content:center;gap:12px;z-index:9;pointer-events:none}
.tourbar.show{display:flex}
.tourbar .tbtn{pointer-events:auto;cursor:pointer;font:600 15px -apple-system,Segoe UI,Roboto,sans-serif;color:#1a1710;background:rgba(226,199,132,.96);border:1px solid rgba(255,255,255,.55);border-radius:13px;padding:13px 18px;min-width:56px;text-align:center;box-shadow:0 8px 26px -8px rgba(0,0,0,.75);-webkit-tap-highlight-color:transparent;user-select:none;touch-action:manipulation}
.tourbar .tbtn:active{transform:translateY(1px);background:#e2c784}
.tourbar .tbtn.arrow{font-size:24px;line-height:1;padding:10px 22px}
.tourbar .tbtn.exit{background:rgba(28,30,36,.92);color:#f4f1ea;border-color:rgba(214,196,150,.5)}
#crosshair:before,#crosshair:after{content:'';position:absolute;background:rgba(255,255,255,.85);box-shadow:0 0 4px rgba(0,0,0,.6)}
#crosshair:before{left:50%;top:4px;bottom:4px;width:2px;margin-left:-1px}
#crosshair:after{top:50%;left:4px;right:4px;height:2px;margin-top:-1px}
#tip{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);max-width:min(86vw,540px);background:rgba(12,13,16,.82);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid rgba(214,196,150,.32);border-left:3px solid #d6b873;border-radius:10px;padding:12px 16px;opacity:0;transition:opacity .18s;pointer-events:none;z-index:6}
#tip.show{opacity:1}
#tip .tT{font-size:15px;font-weight:600;color:#f4f1ea}
#tip .tD{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#d6b873;margin-top:2px}
#tip .tX{font-size:12.5px;color:#bdb7ab;margin-top:6px;line-height:1.5;max-height:84px;overflow:hidden}
#viewer{position:fixed;inset:0;background:rgba(6,7,9,.94);display:none;flex-direction:column;z-index:20}
#viewer.show{display:flex}
#viewer .vimg{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:18px}
#viewer img{max-width:100%;max-height:100%;object-fit:contain;border-radius:6px;box-shadow:0 20px 60px rgba(0,0,0,.6)}
#viewer .vmeta{background:rgba(12,13,16,.96);border-top:1px solid rgba(214,196,150,.2);padding:16px 22px;cursor:default}
#viewer .vmeta .t{font-size:19px;font-weight:600;color:#f4f1ea}
#viewer .vmeta .d{font-size:12px;letter-spacing:.07em;text-transform:uppercase;color:#d6b873;margin-top:3px}
#viewer .vmeta .x{font-size:14px;color:#cfc9bd;margin-top:9px;line-height:1.6;max-height:26vh;overflow-y:auto;touch-action:pan-y;-webkit-overflow-scrolling:touch}
#viewerClose{position:absolute;top:16px;right:16px;width:42px;height:42px;border-radius:50%;border:1px solid rgba(255,255,255,.2);background:rgba(20,22,26,.7);color:#ece8df;font-size:22px;line-height:40px;text-align:center;cursor:pointer;z-index:21}
#enter{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:radial-gradient(120% 120% at 50% 30%,rgba(20,22,28,.72),rgba(6,7,9,.97));z-index:30;text-align:center;padding:24px;transition:opacity .5s}
#enter.hide{opacity:0;pointer-events:none}
#enter h1{font-size:26px;font-weight:600}
#enter .sub{font-size:14px;color:#a8a297;max-width:360px;line-height:1.6}
#enter .cta{margin-top:10px;padding:14px 32px;border-radius:30px;background:#d6b873;color:#1a1408;font-weight:600;font-size:15px;box-shadow:0 10px 30px -8px rgba(214,196,150,.5);cursor:pointer}
#hint{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);font-size:12.5px;color:#bdb7ab;background:rgba(12,13,16,.7);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:8px 16px;opacity:0;transition:opacity .3s;pointer-events:none;z-index:6;text-align:center;max-width:90vw}
#hint.show{opacity:1}
#loading{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#0a0b0d;z-index:40;color:#d6b873;font-size:13px;letter-spacing:.12em;text-transform:uppercase;transition:opacity .4s}
#loading.hide{opacity:0;pointer-events:none}
#joy{position:fixed;left:26px;bottom:30px;width:118px;height:118px;border-radius:50%;border:1.5px solid rgba(214,196,150,.3);background:rgba(20,22,26,.35);display:none;z-index:8;touch-action:none}
#joy.show{display:block}
#knob{position:absolute;left:50%;top:50%;width:52px;height:52px;margin:-26px 0 0 -26px;border-radius:50%;background:rgba(214,196,150,.85);box-shadow:0 4px 14px rgba(0,0,0,.4)}
</style>
</head>
<body>
<canvas id="gl"></canvas>
<div id="crosshair"></div>
<div id="benchHint"></div>
<div id="tourMsg"></div>
<div id="tourStart" class="tourbar"><button class="tbtn" id="tsBtn">▶ Iniciar recorrido</button></div>
<div id="tourNav" class="tourbar"><button class="tbtn arrow" id="tnPrev">‹</button><button class="tbtn exit" id="tnExit">Salir</button><button class="tbtn arrow" id="tnNext">›</button></div>
<div id="tip"><div class="tT" id="tipT"></div><div class="tD" id="tipD"></div><div class="tX" id="tipX"></div></div>
<div id="viewer"><div id="viewerClose">&times;</div><div class="vimg"><img id="viewerImg" alt=""></div><div class="vmeta"><div class="t" id="vT"></div><div class="d" id="vD"></div><div class="x" id="vX"></div></div></div>
<div id="joy"><div id="knob"></div></div>
<div id="hint"></div>
<div id="enter"><h1 id="eTitle">Galería virtual</h1><div class="sub" id="eSub"></div><div class="cta" id="eCta">Entrar</div></div>
<div id="loading">Cargando galería…</div>
